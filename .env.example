NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLOUDFLARE_API_TOKEN=cfut_your_cloudflare_api_token

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# One-off donation: configure this Stripe Price as EUR, customer-entered amount, €5 minimum.
STRIPE_GENERAL_DONATION_PRICE_ID=price_your_customer_entered_donation_price

STRIPE_MONTHLY_SUPPORT_PRICE_10=price_your_10_eur_monthly_support_price
STRIPE_MONTHLY_SUPPORT_PRICE_25=price_your_25_eur_monthly_support_price
STRIPE_MONTHLY_SUPPORT_PRICE_50=price_your_50_eur_monthly_support_price
STRIPE_MONTHLY_SUPPORT_PRICE_100=price_your_100_eur_monthly_support_price

STRIPE_SPONSORSHIP_CONTIGO_PRICE_15=price_your_contigo_15_eur_monthly_price
STRIPE_SPONSORSHIP_CONTIGO_PRICE_30=price_your_contigo_30_eur_monthly_price
